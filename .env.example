VEYRA_HUB_USERNAME=admin
VEYRA_HUB_TOKEN=replace-with-a-long-random-password

# SeriousSportSync (self-hosted sports calendar/stream addon, run alongside
# veyra-hub via the serioussportsync service in compose.yaml). Generate with
# `openssl rand -hex 32`. Required.
SSS_SESSION_SECRET=replace-with-openssl-rand-hex-32
# Username that becomes administrator on first sign-up at http://127.0.0.1:7000.
SSS_ADMIN_USER=admin
